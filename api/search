counting-model#contraction-einsum-family","content":"`inner`"},"1609":{"id":"/docs/understanding/flop-counting-model-400","page_id":"/docs/understanding/flop-counting-model","tags":[],"type":"text","url":"/docs/understanding/flop-counting-model#contraction-einsum-family","content":"`(m,k) · (n,k) → (m,n)` — contracts the **last** axes"},"1610":{"id":"/docs/understanding/flop-counting-model-401","page_id":"/docs/understanding/flop-counting-model","tags":[],"type":"text","url":"/docs/understanding/flop-counting-model#contraction-einsum-family","content":"`2mkn − mn`"},"1611":{"id":"/docs/understanding/flop-counting-model-402","page_id":"/docs/understanding/flop-counting-model","tags":[],"type":"text","url":"/docs/understanding/flop-counting-model#contraction-einsum-family","content":"`tensordot`, `linalg.tensordot`"},"1612":{"id":"/docs/understanding/flop-counting-model-403","page_id":"/docs/understanding/flop-counting-model","tags":[],"type":"text","url":"/docs/understanding/flop-counting-model#contraction-einsum-family","content":"contracts the chosen axes"},"1613":{"id":"/docs/understanding/flop-counting-model-404","page_id":"/docs/understanding/flop-counting-model","tags":[],"type":"text","url":"/docs/understanding/flop-counting-model#contraction-einsum-family","content":"`(2K − 1) × M`"},"1614":{"id":"/docs/understanding/flop-counting-model-405","page_id":"/docs/understanding/flop-counting-model","tags":[],"type":"text","url":"/docs/understanding/flop-counting-model#contraction-einsum-family","content":"`outer`, `linalg.outer`"},"1615":{"id":"/docs/understanding/flop-counting-model-406","page_id":"/docs/understanding/flop-counting-model","tags":[],"type":"text","url":"/docs/understanding/flop-counting-model#contraction-einsum-family","content":"`(m,) · (n,) → (m,n)` — nothing summed, `K = 1`"},"1616":{"id":"/docs/understanding/flop-counting-model-407","page_id":"/docs/understanding/flop-counting-model","tags":[],"type":"text","url":"/docs/understanding/flop-count